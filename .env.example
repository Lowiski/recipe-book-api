# Application
APP_NAME=Recipe Book API
PORT=7000
NODE_ENV=development

# Frontend origin allowed to call this API with credentials
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:7000

# Secrets - replace with long random strings in production
JWT_SECRET=replace_with_a_long_random_secret
CSRF_SECRET=replace_with_a_different_random_secret

# PostgreSQL connection string (Neon in production)
DATABASE_URL=
